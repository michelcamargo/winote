# Variaveis de Ambiente - Winote
#
# Este arquivo documenta todas as variaveis de ambiente necessarias
# para rodar o projeto em qualquer ambiente (dev, staging, producao).
#
# Como usar:
#   1. Copie este arquivo para .env
#   2. Preencha os valores reais
#   3. .env esta no .gitignore (nao commitar)

# ------------------------------------------------------------------
# Supabase - Configuracao do Banco e API
# ------------------------------------------------------------------
# Obrigatorio para conectar ao PostgreSQL e REST API.
# Obter em: https://supabase.com/dashboard/project/{id}/settings/api

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_KEY=

# ------------------------------------------------------------------
# iOS Widget - App Group
# ------------------------------------------------------------------
# Necessario para compartilhar dados entre o app e o widget.
# Deve corresponder ao entitlement configurado no app.json.

EXPO_PUBLIC_APP_GROUP_ID=group.com.winote

# ------------------------------------------------------------------
# PostgreSQL - String de Conexao Direta
# ------------------------------------------------------------------
# Usada apenas para migrations/scripts DDL (nao no app mobile).

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
